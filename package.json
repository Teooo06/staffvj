{
  "name": "staffvj",
  "productName": "StaffVJ",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema VJ live per Stafffeste — mixer video, effetti, testi, audio-reattivo e output su proiettore.",
  "author": "Stafffeste",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "smoke": "npm run build && VJ_LOAD_DIST=1 VJ_SMOKE=1 electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "prepare:ndi-platform": "node scripts/prepare-ndi-platform.cjs",
    "dist:win": "npm run prepare:ndi-platform -- win32 x64 && npm run build && electron-builder --win"
  },
  "dependencies": {
    "grandi": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
